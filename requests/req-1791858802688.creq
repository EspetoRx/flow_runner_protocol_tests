{
  "version": "1.0",
  "name": "PokeAPI GraphQL (Pokémon)",
  "request": {
    "name": "PokeAPI GraphQL (Pokémon)",
    "method": "GET",
    "protocol": "graphql",
    "protocolConfig": {
      "query": "query {\n  gen1_pokemon: pokemon_v2_pokemonspecies(limit: 5) {\n    name\n    id\n    pokemon_v2_pokemongeneras(where: {pokemon_v2_language: {name: {_eq: \"en\"}}}) {\n      genus\n    }\n  }\n}",
      "variables": "{\n  \n}",
      "headers": "{\n  \"Content-Type\": \"application/json\"\n}"
    },
    "url": "https://beta.pokeapi.co/graphql/v1beta",
    "queryParams": [],
    "headerParams": [],
    "auth": {
      "type": "none"
    },
    "body": "",
    "preRequestScript": "",
    "testScript": "",
    "postRequestScript": ""
  }
}